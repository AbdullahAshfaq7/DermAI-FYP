{
  "expo": {
    "name": "DermAI",
    "slug": "dermai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/branding/app-icon-square.png",
    "scheme": "dermaai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dermai.app"
    },
    "android": {
      "package": "com.dermai.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/branding/adaptive-icon-foreground-square.png",
        "backgroundColor": "#150E26"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/branding/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/Splash-screen.png",
          "resizeMode": "cover",
          "backgroundColor": "#150E26",
          "dark": {
            "backgroundColor": "#150E26"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DermAI needs your photos so you can upload a face photo for skin analysis or send one to your dermatologist."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "DermAI uses the camera to take a photo of your face for skin analysis. Photos stay private to you.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "DermAI adds your dermatologist visits to your calendar when you ask it to."
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
