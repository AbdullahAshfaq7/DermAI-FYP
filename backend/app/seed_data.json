  "CONCERNS": {
    "acne": {
      "key": "acne",
      "label": "Acne",
      "icon": "water-drop",
      "toneNote": "On medium to deep skin, spots often leave dark marks that last longer than the spot itself.",
      "helps": [
        {
          "icon": "science",
          "title": "Salicylic acid 2%",
          "subtitle": "Clears pores, evening, 3 times a week"
        },
        {
          "icon": "spa",
          "title": "Niacinamide 5%",
          "subtitle": "Calms spots and fades marks"
        }
      ],
      "doctorHint": "Deep, painful or scarring spots? A dermatologist can offer treatments you can't buy over the counter."
    },
    "dryness": {
      "key": "dryness",
      "label": "Dryness",
      "icon": "eco",
      "toneNote": "Dry patches can look ashy or grey on deeper skin rather than red.",
      "helps": [
        {
          "icon": "water-drop",
          "title": "Glycerin or hyaluronic acid",
          "subtitle": "On damp skin, morning and night"
        },
        {
          "icon": "spa",
          "title": "Ceramide moisturiser",
          "subtitle": "Seals water in, especially on cheeks"
        }
      ],
      "doctorHint": "Cracking, bleeding or itchy patches that don't settle may need a dermatologist's look."
    },
    "redness": {
      "key": "redness",
      "label": "Redness",
      "icon": "local-fire-department",
      "toneNote": "On medium skin it can show as darker, not pinker, patches.",
      "helps": [
        {
          "icon": "spa",
          "title": "Azelaic acid or niacinamide",
          "subtitle": "Calms redness, evening"
        },
        {
          "icon": "wb-sunny",
          "title": "SPF 30+ every morning",
          "subtitle": "Heat and sun make it worse"
        }
      ],
      "doctorHint": "Not easing in 6 weeks? A dermatologist can check for rosacea."
    },
    "darkSpots": {
      "key": "darkSpots",
      "label": "Dark spots",
      "icon": "blur-on",
      "toneNote": "Deeper skin makes more pigment after any irritation, so marks are common and slow to fade.",
      "helps": [
        {
          "icon": "wb-sunny",
          "title": "Mineral SPF 30+ daily",
          "subtitle": "Stops marks getting darker"
        },
        {
          "icon": "science",
          "title": "Azelaic acid 10%",
          "subtitle": "Fades marks over 8 to 12 weeks"
        }
      ],
      "doctorHint": "A spot that changes shape, colour or size should be seen by a dermatologist soon."
    },
    "sensitivity": {
      "key": "sensitivity",
      "label": "Sensitivity",
      "icon": "favorite-border",
      "toneNote": "Stinging and tightness matter more than colour change on deeper skin.",
      "helps": [
        {
          "icon": "block",
          "title": "Fragrance-free products",
          "subtitle": "Fewer ingredients, fewer reactions"
        },
        {
          "icon": "spa",
          "title": "Patch test new products",
          "subtitle": "Inside the arm for 48 hours"
        }
      ],
      "doctorHint": "Swelling, hives or burning after a product? Stop it and see a dermatologist."
    },
    "pores": {
      "key": "pores",
      "label": "Pores",
      "icon": "grid-view",
      "toneNote": "Pores look the same on every tone; oil and heat make them more visible.",
      "helps": [
        {
          "icon": "spa",
          "title": "Niacinamide 5%",
          "subtitle": "Balances oil on the T-zone"
        },
        {
          "icon": "science",
          "title": "Salicylic acid 2%",
          "subtitle": "Clears the pore lining, evening"
        }
      ],
      "doctorHint": "Pores are harmless. A dermatologist can discuss procedures if they bother you."
    }
  },
