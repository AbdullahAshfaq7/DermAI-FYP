# Copy to backend/.env and change for anything beyond local development.
DERMAI_DATABASE_URL=postgresql+psycopg://dermai@localhost:5433/dermai
# Long random string; tokens and file links are signed with it.
DERMAI_SECRET_KEY=change-me-to-a-long-random-string
DERMAI_DEV_MODE=true
DERMAI_TIMEZONE=Asia/Karachi
DERMAI_COMMISSION_PCT=10
DERMAI_DEMO_PASSWORD=demo1234
DERMAI_ADMIN_EMAIL=admin@dermai.pk
DERMAI_ADMIN_PASSWORD=admin1234
DERMAI_CORS_ORIGINS=*
